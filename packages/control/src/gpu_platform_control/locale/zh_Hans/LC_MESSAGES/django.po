msgstr "此服务器当前无法构建镜像。请选择可用于构建的服务器。"

msgid "This server does not offer this feature. Choose a server that supports it."
msgstr "此服务器不提供这项功能。请选择支持该功能的服务器。"

msgid "This server is closed to new requests. Select another server or try again later."
msgstr "此服务器暂停接受新申请。请选择其他服务器，或稍后重试。"

msgid "This server is offline. Choose another server or wait for it to reconnect."
msgstr "此服务器已离线。请选择其他服务器，或等待恢复连接。"

msgid "This server is unavailable. Select another server or try again later."
msgstr "服务器暂不可用。请选择其他服务器，或稍后重试。"

msgid "This server name is in use. Choose another name."
msgstr "服务器名称已被使用，请选择其他名称。"

msgid "Time extension approved"
msgstr "延期申请已通过"

msgid "Time extension declined"
msgstr "延期申请未通过"

msgid "Time extension requested"
msgstr "延期申请已提交"

msgid "Transferring"
msgstr "传输中"

msgid "Unknown server"
msgstr "未知服务器"

msgid "Use the home volume size assigned to your account. Ask an administrator if you need more space."
msgstr "请使用账号分配的个人卷容量。如需更多空间，请联系管理员。"

msgid "Wait for the server's tasks to release their resources before changing the connection."
msgstr "请等待服务器上的任务释放资源，再修改连接。"

msgid "Work volume deleted"
msgstr "工作卷已删除"

msgid "Work volume scheduled for deletion"
msgstr "工作卷即将删除"

msgid "Your account has no quota for this resource. Ask an administrator to assign one."
msgstr "账号尚未分配此项资源额度，请联系管理员分配。"

msgid "Enter a key name."
msgstr "请输入密钥名称。"

msgid "Enter a value within the allowed range."
msgstr "请输入允许范围内的值。"

msgid "GPU allocations"
msgstr "GPU 分配详情"

msgid "GPU memory"
msgstr "显存"

msgid "Select a connection module."
msgstr "请选择连接模块。"

msgid "Select a group for these members."
msgstr "请为这些成员选择用户组。"

msgid "Select valid notification events."
msgstr "请选择有效的通知事件。"

msgid "Settings saved."
msgstr "设置已保存。"

msgid "Synchronization"
msgstr "同步"
