{
  "name": "gpu-platform-panel",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:api": "openapi-typescript /tmp/gpu-platform-openapi.json -o src/api/openapi.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/newsreader": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@vueuse/core": "^13.0.0",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.0",
    "reka-ui": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.4.0",
    "openapi-typescript": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "vue-tsc": "^2.2.8"
  }
