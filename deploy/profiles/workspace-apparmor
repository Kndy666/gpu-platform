# Derived from Moby's Apache-2.0 default container profile; see LICENSE.moby.
# Permit namespace-local mounts used by bubblewrap. Outer container capabilities
# continue to exclude SYS_ADMIN, SYS_PTRACE and NET_ADMIN.
#include <tunables/global>
profile gpu-platform-workspace flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  deny network alg,
  deny network vsock,
  capability,
  file,
  mount,
  umount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=dockerd,
  signal (send,receive) peer=gpu-platform-workspace,
  deny /{proc,run/platform-proc}/* w,
  deny /{proc,run/platform-proc}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  # IPv4/IPv6 sysctls belong to the container's network namespace.
  # Protect the remaining sysctl trees, including global networking settings.
  deny /{proc,run/platform-proc}/sys/[^kn]** w,
  deny /{proc,run/platform-proc}/sys/n[^e]** w,
  deny /{proc,run/platform-proc}/sys/ne[^t]** w,
  deny /{proc,run/platform-proc}/sys/net[^/]** w,
  deny /{proc,run/platform-proc}/sys/net/[^i]** w,
  deny /{proc,run/platform-proc}/sys/net/i[^p]** w,
  deny /{proc,run/platform-proc}/sys/net/ip[^v]** w,
  deny /{proc,run/platform-proc}/sys/net/ipv[^46]** w,
  deny /{proc,run/platform-proc}/sys/kernel/** w,
  deny /{proc,run/platform-proc}/sysrq-trigger rwklx,
  deny /{proc,run/platform-proc}/{acpi,asound,kcore,keys,latency_stats,timer_list,timer_stats,sched_debug,scsi}{,/**} rwklx,
  deny /{sys,run/platform-sys}/[^f]*/** wklx,
  deny /{sys,run/platform-sys}/f[^s]*/** wklx,
  deny /{sys,run/platform-sys}/fs/[^c]*/** wklx,
  deny /{sys,run/platform-sys}/fs/c[^g]*/** wklx,
  deny /{sys,run/platform-sys}/fs/cg[^r]*/** wklx,
  deny /{sys,run/platform-sys}/firmware/** rwklx,
  deny /{sys,run/platform-sys}/devices/virtual/powercap/** rwklx,
  deny /{sys,run/platform-sys}/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer=gpu-platform-workspace,
}
